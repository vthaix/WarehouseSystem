<div class="heading"><div><div class="eyebrow">WAREHOUSE / MẶT HÀNG</div><h1><%= editing?'Sửa mặt hàng':'Tạo mặt hàng' %></h1></div></div>
<div class="panel content"><% if(error){ %><div class="error" role="alert"><%= error %></div><% } %>
<form method="post" action="/products<%= editing?'/'+product.id:'' %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="_key" value="<%= key %>"><% if(editing){ %><input type="hidden" name="version" value="<%= product.version %>"><% } %><div class="form-grid">
<% if(!editing){ %><div class="field"><label for="code">Mã hàng *</label><input id="code" name="code" required maxlength="50" value="<%= product.code||'' %>"></div><div class="field"><label for="kind">Loại *</label><select id="kind" name="kind"><% ['MATERIAL','FINISHED_PRODUCT'].forEach(k=>{ %><option value="<%= k %>" <%= product.kind===k?'selected':'' %>><%= labels[k] %></option><% }) %></select></div><div class="field"><label for="category_id">Danh mục *</label><select id="category_id" name="category_id"><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= product.category_id===c.id?'selected':'' %>><%= c.name %></option><% }) %></select></div><div class="field"><label for="unit_id">Đơn vị *</label><select id="unit_id" name="unit_id"><% units.forEach(c=>{ %><option value="<%= c.id %>" <%= product.unit_id===c.id?'selected':'' %>><%= c.name %></option><% }) %></select></div><% } %>
<div class="field"><label for="name">Tên mặt hàng *</label><input id="name" name="name" required maxlength="150" value="<%= product.name||'' %>"></div><div class="field"><label for="reference_price">Giá tham khảo *</label><input id="reference_price" name="reference_price" inputmode="decimal" required value="<%= product.reference_price %>"></div><div class="field"><label for="description">Mô tả</label><textarea id="description" name="description"><%= product.description||'' %></textarea></div>
<% [['is_active','Đang hoạt động'],['is_sample','Hàng mẫu'],['is_published','Công bố']].forEach(([k,label])=>{ %><div class="field"><label for="<%= k %>"><%= label %></label><select id="<%= k %>" name="<%= k %>"><option value="false" <%= !product[k]?'selected':'' %>>Không</option><option value="true" <%= product[k]?'selected':'' %>>Có</option></select></div><% }) %>
</div><div class="form-actions"><a class="button" href="/products">Hủy</a><button class="button primary" type="submit">Lưu thông tin</button></div></form></div>
