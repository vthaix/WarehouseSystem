{
  "name": "warehouse-system",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/services/web-gateway/index.js",
    "dev": "node --watch src/services/web-gateway/index.js",
    "start:legacy": "node src/server.js",
    "start:identity": "node src/services/identity-service/index.js",
    "start:business": "node src/services/business-service/index.js",
    "start:warehouse": "node src/services/warehouse-service/index.js",
    "start:notification": "node src/services/notification-service/index.js",
    "start:reporting": "node src/services/reporting-service/index.js",
    "test": "node --test",
    "check": "node scripts/check.cjs",
    "docs:sync": "node scripts/sync-project-docs.cjs",
    "check:sync": "node scripts/check-project-sync.cjs",
    "test:browser": "node e2e/run.cjs",
    "test:docker-browser": "node e2e/docker.cjs",
    "test:imports:browser": "node e2e/source-imports.cjs",
    "test:stock-requests:browser": "node e2e/warehouse-request-workflow.cjs",
    "test:inspection:browser": "node e2e/inspection-workflow.cjs",
    "test:accounts-catalog:browser": "node e2e/accounts-catalog.cjs",
    "test:lookup:browser": "node e2e/warehouse-lookup.cjs",
    "test:preproduction:browser": "node e2e/preproduction.cjs",
    "test:customer-order:browser": "node e2e/customer-order.cjs",
    "test:reset:browser": "node e2e/reset-data.cjs",
    "test:warehouse:browser": "node e2e/warehouse-exceptions.cjs",
    "test:theme:browser": "node e2e/admin-theme.cjs",
    "test:category-images:browser": "node e2e/category-images.cjs",
    "test:orders:db": "node scripts/order-smoke.cjs",
    "test:domain:db": "node scripts/domain-schema-smoke.cjs",
    "test:production:db": "node scripts/production-smoke.cjs",
    "test:commerce:db": "node scripts/commerce-smoke.cjs",
    "test:tasks:db": "node scripts/tasks-smoke.cjs",
    "test:stocktakes:db": "node scripts/stocktake-smoke.cjs",
    "test:acceptance:db": "node scripts/isolated-acceptance.cjs",
    "test:acceptance:split": "node scripts/split-acceptance.cjs",
    "db:split": "node scripts/split-service-databases.cjs",
    "db:migrate": "node scripts/database.cjs migrate",
    "db:seed": "node scripts/database.cjs seed",
    "db:status": "node scripts/database.cjs status",
    "format": "prettier --write src public tests e2e scripts/check.cjs README.md docs/IMPLEMENTATION.md"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "mysql2": "^3.24.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "prettier": "^3.9.9"
  }
}
