PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
INTERNAL_SECRET=replace-with-another-random-secret-at-least-32-characters
# Docker Compose provisions secret files and service URLs automatically.
# For separate local Node processes, set each service PORT and these URLs:
IDENTITY_SERVICE_URL=http://127.0.0.1:3101
BUSINESS_SERVICE_URL=http://127.0.0.1:3102
WAREHOUSE_SERVICE_URL=http://127.0.0.1:3103
NOTIFICATION_SERVICE_URL=http://127.0.0.1:3104
REPORTING_SERVICE_URL=http://127.0.0.1:3105
DEMO_PASSWORD=replace-with-your-demo-password
STORAGE_DRIVER=memory
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=warehouse_system
# Compose DB_NAME is the archived source/prefix. Service databases append
# _Identity/_Business/_Warehouse/_Notification/_Reporting/_Gateway.
# Local per-service Node processes must set DB_NAME/DB_USER/DB_PASSWORD individually.
DB_USER=warehouse_app
DB_PASSWORD=replace-with-your-mysql-password
IDENTITY_DB_USER=identity_db
IDENTITY_DB_PASSWORD=identity123
BUSINESS_DB_USER=business_db
BUSINESS_DB_PASSWORD=business123
WAREHOUSE_DB_USER=warehouse_db
WAREHOUSE_DB_PASSWORD=warehouse123
NOTIFICATION_DB_USER=notification_db
NOTIFICATION_DB_PASSWORD=notification123
REPORTING_DB_USER=reporting_db
REPORTING_DB_PASSWORD=reporting123
GATEWAY_DB_USER=gateway_db
GATEWAY_DB_PASSWORD=gateway123
