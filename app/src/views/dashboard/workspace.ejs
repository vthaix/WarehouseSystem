<section class="work-hero"><div><span class="work-eyebrow">SWEET TASTE · KHÔNG GIAN LÀM VIỆC</span><h1>Chào <%= user.full_name %>,<br>cùng bắt đầu một ngày chỉn chu.</h1><p>Những việc cần làm, kế hoạch mới và cập nhật của bạn — gọn trong một nơi.</p><span class="work-date"><%= new Date().toLocaleDateString('vi-VN',{timeZone:'Asia/Ho_Chi_Minh',weekday:'long',day:'2-digit',month:'2-digit',year:'numeric'}) %></span></div><img src="/images/items/hop-banh.png" alt="Hộp bánh Sweet Taste"></section>
<div class="work-stats"><% workspace.tiles.forEach(t=>{ %><a class="work-stat" href="<%= t.url %>" data-go="<%= t.key %>"><span class="work-stat-top"><span><%= t.label %></span><span class="work-stat-icon" aria-hidden="true"><%= t.icon %></span></span><strong><%= t.count.toLocaleString('vi-VN') %></strong><small>Xem danh sách →</small></a><% }) %></div>
<div class="work-grid"><section class="work-panel"><div class="work-panel-head"><h2>Công việc trong phạm vi của bạn</h2><span>Theo chức năng</span></div>
 <% const bars=workspace.tiles.filter(t=>t.key!=='notifications'),max=Math.max(1,...bars.map(t=>t.count)); %>
 <% if(!bars.length){ %><p class="subtitle">Các nghiệp vụ của bạn nằm trong phần truy cập nhanh bên dưới.</p><% } %>
 <% bars.forEach(t=>{ %><div class="work-bar-row"><span><%= t.label %></span><strong><%= t.count %></strong><meter class="work-meter" min="0" max="<%= max %>" value="<%= t.count %>" aria-label="<%= t.label %>"><%= t.count %></meter></div><% }) %>
 <p class="hint">Số liệu hiện tại theo quyền tài khoản. Một chứng từ có thể liên quan nhiều chức năng.</p>
 </section><section class="work-panel"><div class="work-panel-head"><h2>Cập nhật gần đây</h2><a class="button small" href="/notifications">Xem tất cả</a></div><div id="recent">
 <% if(!rows.length){ %><div class="empty">Bạn chưa có thông báo.<br><span class="hint">Cập nhật mới sẽ xuất hiện tại đây.</span></div><% } %>
 <% rows.forEach(n=>{ const m=available.find(m=>m[0]===n.resource_type),href=m?m[5]+'?module='+encodeURIComponent(m[0])+'&view='+encodeURIComponent(n.resource_id):'/notifications'; %><a class="work-activity" href="<%= href %>"><span class="work-dot" aria-hidden="true"><%= n.read_at?'✓':'•' %></span><span><strong><%= n.title %></strong><small><%= format(n.created_at,'created_at') %><%= n.read_at?'':' · Chưa đọc' %></small></span></a><% }) %>
 </div></section></div>
<% if(user.roles.includes('PURCHASER')){ %><section class="work-panel" style="margin-bottom:24px"><div class="work-panel-head"><h2>Sẵn sàng đặt mua nguyên vật liệu</h2><a class="button primary small" href="/purchases?module=purchase-orders">Mở đặt hàng →</a></div><p class="subtitle"><%= workspace.counts['purchase-orders']||0 %> kế hoạch đã duyệt chưa có đơn mua. Mở Đặt hàng để chọn nguồn và nhà cung cấp.</p></section><% } %>
<div class="work-panel-head"><h2>Truy cập nhanh</h2><span><%= user.roles.map(r=>labels[r]||r).join(' · ') %></span></div><div class="work-shortcuts"><% available.filter(m=>m[0]!=='notifications').forEach(m=>{ %><a class="work-shortcut" href="<%= m[5] %>?module=<%= m[0] %>" data-go="<%= m[0] %>"><span aria-hidden="true"><%= m[2] %></span><span><strong><%= m[1] %></strong><small>Mở chức năng →</small></span></a><% }) %></div>
<%- include('../partials/footer') %>
