<div class="heading"><div><div class="eyebrow">WAREHOUSE / VẬN HÀNH</div><h1><%= title %></h1><div class="subtitle"><%= module[6] %></div></div><% if(canCreate){ %><button class="button primary" id="create">＋ Tạo mới</button><% } else if(current.startsWith('reports/')) { %><a class="button" id="export" href="/api/v1/<%= current %>/export?<%= new URLSearchParams({...query,...(meta.as_of?{as_of:meta.as_of}:{})}).toString() %>">↗ Xuất CSV</a><% } %></div>
<div class="panel"><form class="filters" id="filters" method="get"><input type="hidden" name="module" value="<%= current %>"><% if(query.type){ %><input type="hidden" name="type" value="<%= query.type %>"><% } %>
<% if(!current.startsWith('reports/')){ %><div><label for="q">Tìm kiếm</label><input id="q" name="q" value="<%= query.q||'' %>" placeholder="Tìm mã, tên chứng từ…"></div><div><label for="status">Trạng thái</label><select id="status" name="status"><option value="">Tất cả trạng thái</option><% ['SUBMITTED','RECEIVED','PENDING','PENDING_APPROVAL','APPROVED','DRAFT','IN_PROGRESS','COMPLETED','POSTED','CLOSED','REJECTED'].forEach(s=>{ %><option value="<%= s %>" <%= query.status===s?'selected':'' %>><%= labels[s] %></option><% }) %></select></div>
<% }else{ %><div><label for="warehouse_id">Mã kho</label><input name="warehouse_id" id="warehouse_id" value="<%= query.warehouse_id||'' %>" placeholder="Ví dụ: 1"></div><% if(current==='reports/inventory'){ %><div><label for="as_of">Mốc thời gian</label><input type="datetime-local" name="as_of" id="as_of"></div><% }else{ %><div><label for="from">Từ ngày</label><input type="date" name="from" id="from" value="<%= query.from||'' %>"></div><div><label for="to">Đến ngày</label><input type="date" name="to" id="to" value="<%= query.to||'' %>"></div><% } %><% } %><button class="button" type="submit">Lọc dữ liệu</button><button class="button" type="button" id="reset">Xóa lọc</button></form>
<div id="table"><% if(rows.length){ %><div class="table-wrap"><table><thead><tr><% columns.forEach(c=>{ %><th><%= c[1] %></th><% }) %><th>Thao tác</th></tr></thead><tbody><% rows.forEach((r,i)=>{ %><tr><% columns.forEach(([k])=>{ %><td><% if(['status','qc_status'].includes(k)){ %><span class="badge <%= r[k]||'' %>"><%= k==='status'?statusLabel(r[k]):labels[r[k]]||r[k]||'—' %></span><% }else{ %><%= format(r[k]) %><% } %></td><% }) %><td><div class="inline-actions"><a class="button small" href="/records/<%= current %>/<%= r.id %>" data-detail="<%= i %>">Chi tiết ↗</a><% if((r.actions||[]).includes('review')){ %><button class="button small" data-act="review" data-index="<%= i %>">Duyệt</button><% } %><% if((r.actions||[]).includes('post')){ %><button class="button small" data-act="post" data-index="<%= i %>">Ghi phiếu</button><% } %></div></td></tr><% }) %></tbody></table></div><% }else{ %><div class="empty"><div class="empty-icon">▤</div>Chưa có dữ liệu phù hợp.<br><span class="hint">Tạo chứng từ mới hoặc thay đổi bộ lọc để tiếp tục.</span></div><% } %>
<div class="pagination"><span><%= meta.total??rows.length %> kết quả · Trang <%= Number(query.page||1) %></span><div class="inline-actions"><a class="button small" id="prev" href="?<%= new URLSearchParams({...query,module:current,page:Math.max(1,Number(query.page||1)-1)}).toString() %>" <%= Number(query.page||1)<=1?'aria-disabled=true':'' %>>← Trước</a><a class="button small" id="next" href="?<%= new URLSearchParams({...query,module:current,page:Number(query.page||1)+1}).toString() %>" <%= !meta.total_pages||Number(query.page||1)>=meta.total_pages?'aria-disabled=true':'' %>>Sau →</a></div></div></div></div>
