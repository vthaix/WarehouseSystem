<div class="heading"><div><div class="eyebrow">KHÁCH HÀNG / UC-02</div><h1>Đặt bánh</h1><p class="subtitle">Chọn nhiều loại bánh trong cùng một đơn. Bộ phận lập kế hoạch sẽ tiếp nhận sau khi bạn gửi.</p></div><a class="button" href="/customer/orders">Đơn hàng của tôi</a></div>
<% if(!products.length){ %><div class="panel empty">Chưa có bánh được công bố để đặt hàng.</div><% }else{ %>
<form id="customer-order-form">
  <div class="cards"><% products.forEach(p=>{ %><section class="card"><% if(p.image_path){ %><img class="customer-item-photo" src="<%= p.image_path %>" alt="<%= p.name %>" loading="lazy"><% } %><div class="eyebrow"><%= p.code %></div><h2><%= p.name %></h2><p><%= Number(p.reference_price).toLocaleString('vi-VN') %> đ / <%= p.unit || 'đơn vị' %></p><label for="cake-<%= p.id %>">Số lượng</label><input id="cake-<%= p.id %>" type="number" min="0" step="0.001" value="0" data-order-item="<%= p.id %>" data-price="<%= p.reference_price %>"><label for="cake-note-<%= p.id %>">Ghi chú riêng</label><input id="cake-note-<%= p.id %>" maxlength="5000" data-item-note="<%= p.id %>" placeholder="Ví dụ: đóng gói riêng"></section><% }) %></div>
  <section class="panel" style="margin-top:24px;padding:24px"><h2>Thông tin nhận hàng</h2><div class="form-grid"><div class="field"><label for="order-address">Địa chỉ nhận hàng *</label><input id="order-address" name="delivery_address" maxlength="500" required autocomplete="street-address"></div><div class="field"><label for="order-date">Ngày muốn nhận *</label><input id="order-date" name="latest_delivery_date" type="date" required></div><div class="field span2"><label for="order-note">Ghi chú đơn hàng</label><textarea id="order-note" name="note" maxlength="5000" rows="3"></textarea></div></div><p>Tổng tiền dự kiến: <strong id="order-total">0 đ</strong></p><div id="order-error" role="alert"></div><button class="button primary" type="submit">Gửi đơn đặt hàng</button></section>
</form><% } %>
