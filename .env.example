# Optional local overrides: fresh clone can run without .env.
# Secrets left blank are randomly generated once into Docker named volumes.
APP_PORT=3000
APP_BIND_ADDRESS=127.0.0.1
ADMINER_PORT=8080
DB_NAME=KhoHang
DB_USER=warehouse_app
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
SESSION_SECRET=
DEMO_PASSWORD=
NODE_ENV=development
AUTO_MIGRATE=true
SEED_DEMO=true
COOKIE_SECURE=false
TRUST_PROXY=0
